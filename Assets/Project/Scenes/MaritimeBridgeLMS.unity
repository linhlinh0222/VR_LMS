  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 31bb7c9e4479987429c46ed6520426be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ComprehensiveDemoRuntime::MaritimeLMS.Lessons.LessonStateMachine
  lessonTitle: Bridge Familiarization & Departure
  briefingText: "You are second officer on watch. The bridge is preparing for departure.\n\nPower
    on the navigation equipment, set the engine telegraph to Slow Ahead, steer to
    course 045\xB0 true, and complete a VHF distress test on Channel 16.\n\nUse 1
    / 2 to switch active hand. Hold T (right) or Y (left) to manipulate hands."
  phases:
  - phase: 1
    title: Briefing
    instructionText: Read the scenario, then press Begin.
    objectives: []
    requireAllComplete: 1
    minPhaseSeconds: 0
    requiresManualAdvance: 1
  - phase: 2
    title: Familiarization
    instructionText: Power on the four navigation systems.
    objectives:
    - {fileID: 385275898}
    - {fileID: 1463970978}
    - {fileID: 638140962}
    - {fileID: 911090378}
    requireAllComplete: 1
    minPhaseSeconds: 0
    requiresManualAdvance: 0
  - phase: 3
    title: Guided procedure
    instructionText: "Set telegraph to Slow Ahead with the right hand, then steer
      to 045\xB0T with the left hand."
    objectives:
    - {fileID: 1456661750}
    - {fileID: 368871619}
    requireAllComplete: 1
    minPhaseSeconds: 0
    requiresManualAdvance: 0
  - phase: 4
    title: Assessment
    instructionText: Complete a VHF distress test on Channel 16 (3-second hold).
    objectives:
    - {fileID: 1767842049}
    requireAllComplete: 1
    minPhaseSeconds: 0
    requiresManualAdvance: 0
  - phase: 5
    title: Debrief
    instructionText: Review your score, then press Restart to retry.
    objectives: []
    requireAllComplete: 1
    minPhaseSeconds: 0
    requiresManualAdvance: 1
  autoStart: 1
  OnLessonStarted:
    m_PersistentCalls:
      m_Calls: []
  OnPhaseChanged:
    m_PersistentCalls:
      m_Calls: []
  OnPhaseEntered:
    m_PersistentCalls:
      m_Calls: []
  OnLessonCompleted:
    m_PersistentCalls:
      m_Calls: []
